{
  "name": "@kopirka/desktop",
  "private": true,
  "version": "0.2.0",
  "description": "Десктопная упаковка «Копирки» на Tauri 2",
  "type": "module",
  "scripts": {
    "prepare:payload": "cd .. && npm run build --workspace=web && npm run build --workspace=server && node desktop/scripts/bundle-server.mjs",
    "icons": "node scripts/make-icons.mjs && tauri icon src-tauri/icons/source-1024.png",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:intel": "node scripts/build-intel.mjs",
    "build:windows": "node scripts/build-windows.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.2"
  }
}
