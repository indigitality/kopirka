{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Копирка",
  "version": "0.2.0",
  "identifier": "pro.instat.kopirka.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "npm run prepare:payload",
    "beforeBuildCommand": "npm run prepare:payload"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Локальная библиотека визуальных референсов",
    "longDescription": "Копирка — локальная база визуальных референсов: плотная сетка превью, папки, теги, поиск. Файлы лежат на диске, сервер локальный, облака нет.",
    "copyright": "© Сергей Оршак",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend": "backend"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
